APP_NAME=FleetIQ API
API_PREFIX=/api/v1
ENVIRONMENT=development

# Use sqlite for quick local runs. Override with Postgres in deployed envs.
DATABASE_URL=sqlite+pysqlite:///./fleetiq.db
REDIS_URL=redis://redis:6379/0

SECRET_KEY=change-me-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Set to true only in development (never in production)
AUTO_CREATE_TABLES=false

AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Optional outbound notification providers
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OCR_PROVIDER_URL=
OCR_PROVIDER_API_KEY=
TELEMATICS_WEBHOOK_SECRET=
